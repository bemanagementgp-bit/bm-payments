# Mercado Pago (Tus integraciones → tu aplicación → Credenciales). Use TEST credentials first, then production.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
# Webhook secret (Tus integraciones → Webhooks → Clave secreta). Optional but recommended.
MP_WEBHOOK_SECRET=
# Random secret that signs license keys. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every key issued so far.
LICENSE_SECRET=
# Public URL of this service (used for notification_url)
PAYMENTS_ORIGIN=https://bm-payments.vercel.app
# Extra allowed origins for CORS (comma separated). *.vercel.app and localhost are always allowed.
ALLOWED_ORIGINS=
# Optional: e-mail the license key after purchase (https://resend.com)
RESEND_API_KEY=
FROM_EMAIL=Be Management Tools <tools@yourdomain.com>
